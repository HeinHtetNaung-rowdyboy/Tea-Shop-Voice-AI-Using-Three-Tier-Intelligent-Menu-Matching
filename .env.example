# Raj-0 HTTP server. For Docker containers, localhost refers to the container itself.
RAJ_API_URL=http://127.0.0.1:8080
RAJ_API_KEY=
RAJ_TIMEOUT_SECONDS=120
# Streamlit -> FastAPI; change to http://api:8000 for Docker Compose
BACKEND_API_URL=http://127.0.0.1:8000
# Set strong unique values before exposing your deployment to the internet.
APP_PASSWORD=change-this-before-going-online
API_KEY=change-this-api-key-before-going-online
# SQLite persistent storage; Docker compose mounts ./data
DATABASE_PATH=data/orders.db
MAX_AUDIO_MB=10

# The third tier is lazy-loaded. Requires requirements-semantic.txt and available RAM.
ENABLE_SEMANTIC=false
SEMANTIC_MODEL_ID=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
